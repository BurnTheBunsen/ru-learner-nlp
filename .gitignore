# Virtual Environment
.venv/

# IDE Settings (PyCharm)
.idea/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebooks
.ipynb_checkpoints/

# Project Data & Corpus
data/*
!data/README.md
!data/framebank/
data/framebank/*.txt
!data/**/
!data/**/.gitkeep
*.csv
*.tsv
*.txt
!requirements.txt

# Models & Binaries
models/*
!models/**/
!models/**/.gitkeep
*.udpipe
*.exe

# OS Generated Files
.DS_Store
Thumbs.db

# Local experiments & diagnostics (track only baseline stress-test files)
experiments/*
!experiments/README.md
!experiments/output_comparison.py

# Root-level scratch files & JSON diagnostic reports
*scratch.py
*_report.json

# Raw FrameBank dictionary files (large, third-party, GPL-3.0)
data/framebank/*.txt

# Learner essays and gold-standard annotations
data/raw/
data/gold_standard/

# Pipeline output -- regenerable, not source
data/processed/