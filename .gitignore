# Virtual Environment
.venv/

# IDE Settings (PyCharm)
.idea/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebooks
.ipynb_checkpoints/

# Project Data & Corpus
data/*
!data/README.md
!data/framebank/
data/framebank/*.txt
!data/**/
!data/**/.gitkeep
*.csv
*.tsv
*.txt
!requirements.txt

# Models & Binaries
models/*
!models/**/
!models/**/.gitkeep
*.udpipe
*.exe

# OS Generated Files
.DS_Store
Thumbs.db

# Scratch file
*scratch.py

# Json report files created by the scratchpads
*_diagnostics_report.json
*_hyphenation_analysis_report.json

# Raw FrameBank dictionary files (large, third-party, GPL-3.0 -- see data/README.md)
data/framebank/*.txt

# Learner essays and gold-standard annotations -- not for git
data/raw/
data/gold_standard/

# Pipeline output -- regenerable, not source
data/processed/